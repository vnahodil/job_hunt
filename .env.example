# ============================================================================
# Environment Variables for Zurich Chemistry Job Radar
# ============================================================================

# Google Gemini API Key (already set in ~/.zshrc, or define here)
# GEMINI_API_KEY="AQ.Ab8..."

# Email Notification Settings (Gmail SMTP)
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Generate a 16-character App Password (name it e.g. "Job Radar")
# 3. Paste the 16 characters below (no spaces):
SMTP_USER="vl.nahodil@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Comma-separated list of recipient emails
NOTIFY_RECIPIENTS="vl.nahodil@gmail.com,girlfriend@example.com"

# Minimum score to include in the daily email digest (default: 7)
MIN_NOTIFY_SCORE=7
